{
  "name": "grazer-harness",
  "version": "0.1.0",
  "description": "A TypeScript single-file build of the grazer CDP harness.",
  "type": "module",
  "bin": {
    "grazer": "./dist/out/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist artifacts",
    "build": "node scripts/build.mjs",
    "e2e": "node scripts/run-real-browser-e2e.mjs",
    "prepare": "if [ \"$CI\" = \"true\" ]; then exit 0; fi; cd ../.. && lefthook install",
    "style:check": "prettier --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && node --test \"src/**/*.test.mjs\" \"test/*.test.js\"",
    "mutation-check": "npm run build && node scripts/mutation-check.mjs",
    "skill:doc": "npm run build && node scripts/generate-skill-doc.mjs",
    "skill:doc:check": "npm run build && node scripts/generate-skill-doc.mjs --check",
    "validate:agent-style": "node scripts/validate-agent-style.mjs",
    "validate:learnings": "npm run build && GRAZER_AGENT_WORKSPACE=../../skills/grazer node dist/scripts/validate-site-skills.js",
    "validate:site-skills": "npm run build && GRAZER_AGENT_WORKSPACE=../../skills/grazer node dist/scripts/validate-site-skills.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.15.29",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "acorn": "^8.16.0"
  }
}
