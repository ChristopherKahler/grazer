{
  "manifest_version": 3,
  "name": "Grazer Sync",
  "version": "0.1.0",
  "description": "Hands your logged-in session for chosen sites to the Grazer companion, on this device only.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grazer Sync"
  }
}
